{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eud-agent",
  "version": "0.4.3",
  "identifier": "dev.tree-some.eud-agent",
  "build": {
    "frontendDist": "../panel/dist",
    "devUrl": "http://localhost:6173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../panel" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../panel" }
  },
  "app": {
    "windows": [
      {
        "title": "eud-agent",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/eud-editor-compat": "native/eud-editor-compat",
      "../vendor/ffmpeg/manifest.json": "vendor/ffmpeg/manifest.json",
      "../vendor/ffmpeg/LICENSE.txt": "vendor/ffmpeg/LICENSE.txt",
      "icons/128x128.png": "icons/notification.png",
      "icons/project.ico": "icons/project.ico"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/raravel/eud-agent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlERTA4QTdENjRGRDAzMTMKUldRVEEvMWtmWXJnblJRbVJlcXN1UCs5VGlCaHgvVWRVczNOd1pGam80MjBIQzJmQUNmSTdLV00K"
    }
  }
}
