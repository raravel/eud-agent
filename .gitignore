# Python virtualenv
.venv/

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo

# eudplib epScript→Python shadows written next to every compiled .eps at build time
__epspy__/

# Tooling caches
.ruff_cache/
.pytest_cache/

# Local scraper credentials; contain an active Naver login session
/naver_cookie.txt

# Node (optional epscript-lsp, panel tooling)
node_modules/
panel/node_modules/

# Panel build output (Vite); never committed, release-packaged later
panel/dist/

# Distribution / release staging output
release/

# Playwright MCP debugging artifacts (console logs, page snapshots)
.playwright-mcp/

# Claude Code agent worktrees
.claude/worktrees/

# Rust / Cargo workspace build output
/target/

# Shared cargo target cache for hv:task worktree workers (warmed dep artifacts;
# avoids per-worktree cold compiles of ort/fastembed/tauri). Not committed.
/.cargo-shared-target/

# fastembed model cache (the bge-m3 ONNX ~560MB) — written by rag tests/runtime
# when no explicit cache dir is set (default is CWD-relative). Never committed.
.fastembed_cache/

# Tauri build-time generated artifacts (regenerated by tauri-build each build)
src-tauri/gen/

# ICU header-staging output from the isom-sys MSBuild (IcuLib copies its public
# headers here, OUTSIDE native/isom/; regenerated every build, never committed)
native/include/

# RAG index builder is a separate cargo workspace under ci/; the root /target/
# rule above is anchored and does not cover ci/target/. Build output, never committed.
ci/target/

# RAG index Release artifacts — built in CI, published to a GitHub Release, NEVER
# committed (rules.md / Decision 15: rag-index.bin is a static read-only CI artifact)
/rag-index.bin
/rag-index.bin.sha256
/rag-index.manifest.json
# Local GJC/agent runtime state and per-file mutation locks
/.gjc/
/.omo/
/src-tauri/src/*.rs.lock/

# Legacy in-tree Cargo target output
/src-tauri/target/

# oh-my-claudecode per-directory runtime state (sessions, notepad, plans); never committed
.omc/

# Cargo output of the isom crate when built standalone (root /target/ rule is anchored)
crates/isom/target/

# Git Bash crash dumps
*.stackdump

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# macOS Finder metadata
.DS_Store
